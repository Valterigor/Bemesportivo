# Configure estes valores somente no ambiente local ou no painel da hospedagem.
# Nunca publique chaves reais no Git.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.6-luna
VISUAL_ANALYSIS_SECRET=

# Supabase. A chave privilegiada deve existir somente no backend da Cloudflare.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_GOOGLE_ENABLED=false

# Notificações push. Gere o par com: npm run push:keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:contato@bemesportivo.com
