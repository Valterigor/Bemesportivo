{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bemesportivo-routine-notifications",
  "main": "workers/routine-notifications.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "BE_DATA",
      "id": "c14e9a5a746c4f459063ce7d7711efeb"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
